__pycache__/
*.pyc
venv/
.pytest_cache/
*.log

# Generated run artifacts (SQLite store, per-run HDF5 files). Regenerate with:
#   venv\Scripts\python.exe scripts\generate_example_campaign.py
data/runs/*.h5
data/*.sqlite
*.sqlite

# Keep the small set of example rendered PNGs used in the README/docs.
data/plots/*.png
!data/plots/example_*.png

# mining/ extension: the compiled miner and the generated 2,000,000-frame
# corpus/queries/ground-truth/run artifacts. Regenerate with:
#   mining/build.sh && python3 mining/generate_corpus.py --seed 7 --out-dir data/mining
mining/mine_frames
data/mining/
data/mining_small/

# approach_comparison/ extension: CMake build dirs and the generated
# 20,000-sample corpus plus every run/mutation artifact the comparison and
# regression-gate scripts produce. Regenerate with:
#   cmake -S approach_comparison -B approach_comparison/build && cmake --build approach_comparison/build
#   python3 approach_comparison/python/corpus.py approach_comparison/data/corpus.tsv approach_comparison/data/manifest.json 20000 1
#   approach_comparison/build/predicate_cli run approach_comparison/data/corpus.tsv approach_comparison/data/predictions_predicates.tsv
approach_comparison/build/
approach_comparison/build-*/
approach_comparison/data/
