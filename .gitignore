__pycache__/
*.pyc
venv/
.pytest_cache/
*.log

# Generated run artifacts (SQLite store, per-run HDF5 files). Regenerate with:
#   venv\Scripts\python.exe scripts\generate_example_campaign.py
data/runs/*.h5
data/*.sqlite
*.sqlite

# Keep the small set of example rendered PNGs used in the README/docs.
data/plots/*.png
!data/plots/example_*.png

# mining/ extension: the compiled miner and the generated 2,000,000-frame
# corpus/queries/ground-truth/run artifacts. Regenerate with:
#   mining/build.sh && python3 mining/generate_corpus.py --seed 7 --out-dir data/mining
mining/mine_frames
data/mining/
data/mining_small/
